{
  "name": "@design-sdk/figma-remote",
  "version": "0.1.0",
  "private": false,
  "description": "Figma remote api & formats",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/gridaco/figma-sdk",
  "repository": "https://github.com/gridaco/figma-sdk",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "build": "tsup lib/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./asset-repository": "./dist/asset-repository/index.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ],
      "asset-repository": [
        "dist/asset-repository/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@design-sdk/asset-repository": "workspace:*",
    "@design-sdk/figma": "workspace:*",
    "@design-sdk/figma-node": "workspace:*",
    "@design-sdk/figma-node-conversion": "workspace:*",
    "@design-sdk/figma-remote-api": "workspace:*",
    "@design-sdk/figma-types": "workspace:*",
    "@design-sdk/figma-utils": "workspace:*"
  },
  "devDependencies": {
    "@design-sdk/figma-remote-types": "workspace:*",
    "axios": "^0.21.1",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
