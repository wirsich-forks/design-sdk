{
  "name": "@design-sdk/core",
  "version": "0.1.0",
  "license": "Apache 2.0",
  "author": "grida.co",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "build": "tsup index.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@base-sdk/base": "0.1.4",
    "@design-sdk/figma-node": "workspace:*",
    "@design-sdk/figma-types": "workspace:*",
    "@design-sdk/figma-utils": "workspace:*",
    "@design-sdk/flags": "workspace:*",
    "@reflect-ui/core": "0.0.5",
    "@reflect-ui/namings": "0.0.3",
    "@reflect-ui/uiutils": "^0.1.2-2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gridaco/figma-sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
