{
  "name": "@design-sdk/flags",
  "description": "extend your design with flags",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "build": "tsup index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./parsing-strategy-dashdash": "./dist/parsing-strategy-dashdash/index.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ],
      "parsing-strategy-dashdash": [
        "dist/parsing-strategy-dashdash/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@design-sdk/core-flags-dashdash": "workspace:*"
  },
  "devDependencies": {
    "@types/assert": "^1.5.6",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gridaco/figma-sdk"
  },
  "publishConfig": {
    "access": "public"
  }
